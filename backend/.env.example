PORT=5000
DB_CLIENT=sqlite
MYSQL_HOST=
MYSQL_PORT=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=defaultdb
# Set to true for hosted MySQL providers (Aiven, etc.) that require TLS.
MYSQL_SSL=true
# Optional: paste the provider's CA certificate contents to verify the
# connection properly instead of just encrypting it.
MYSQL_SSL_CA= 


ML_SERVICE_URL=http://127.0.0.1:8001
FRONTEND_ORIGIN=http://localhost:5173

# Auth — change this before any real deployment.
JWT_SECRET=change-this-to-a-long-random-string

# AISStream: configure AISSTREAM_API_KEY in ml-service/.env, NOT here.
