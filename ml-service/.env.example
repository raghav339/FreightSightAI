# AISStream live AIS
# Create an API key at https://aisstream.io/account
# IMPORTANT: keep this only on the ML-service/server; never expose it as VITE_* or frontend config.
AISSTREAM_API_KEY=
# Production AIS persistence. Reuse the same MySQL database configured for the Node backend.
# Set AIS_DB_CLIENT=mysql on Render/production. SQLite is used automatically for local dev
# when MYSQL_HOST is not configured.
AIS_DB_CLIENT=mysql
AIS_RETENTION_DAYS=30
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=defaultdb
MYSQL_SSL=true
MYSQL_SSL_CA=
AISSTREAM_DB=./data/production/aisstream_live.sqlite3

# Brent crude reference price (feeds one small "fuel cost shock" risk factor).
# Refreshed automatically at startup and daily from FRED (no API key needed).
# Set BRENT_ENABLED=false to turn the fetcher and the risk factor off.
BRENT_ENABLED=true

# Live marine conditions (Disruption Engine's "Live" mode) — REQUIRED.
# Get a free key at https://www.weatherapi.com/pricing.aspx (no card needed).
# Without this set, Live mode will report conditions as unavailable rather
# than fabricate a reading. (Previously this used Open-Meteo, which needs no
# key but shares Render's outbound IP with other tenants, causing frequent
# 429 rate-limit errors that this app has no way to avoid or fix.)
WEATHERAPI_KEY=

# Route-freight models load lazily per lane; this is how many lanes stay cached in RAM.
# ROUTE_MODEL_CACHE_LANES=24
# Show Python logs immediately on hosts like Render (recommended).
PYTHONUNBUFFERED=1
# BRENT_CACHE_FILE=./data/production/brent_oil.csv
# BRENT_SOURCE_URL=https://fred.stlouisfed.org/graph/fredgraph.csv?id=DCOILBRENTEU
