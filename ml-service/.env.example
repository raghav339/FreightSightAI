# AISStream live AIS
# Create an API key at https://aisstream.io/account
# IMPORTANT: keep this only on the ML-service/server; never expose it as VITE_* or frontend config.
AISSTREAM_API_KEY=
# Production AIS persistence. Reuse the same MySQL database configured for the Node backend.
# Set AIS_DB_CLIENT=mysql on Render/production. SQLite is used automatically for local dev
# when MYSQL_HOST is not configured.
AIS_DB_CLIENT=mysql
AIS_RETENTION_DAYS=30
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=defaultdb
MYSQL_SSL=true
MYSQL_SSL_CA=
AISSTREAM_DB=./data/production/aisstream_live.sqlite3
